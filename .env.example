# Society Plot Manager — environment template.
#
# Source of this key list: AGENTS.md AG-Q4, which derives it from
# ARCHITECTURE.md §14.5 (database roles, APP_SECRETS_KEY, backup), §10.10
# (provider mode), §14.1 (HEALTH_DETAILS_TOKEN), plus DATABASE_URL, SESSION_*,
# PKT_TZ and PORT. ARCHITECTURE.md §14.2 shows how Compose consumes the parts.
#
# Every value below is a PLACEHOLDER. No real secret is ever committed
# (ARCHITECTURE.md §14.5); copy to `.env` and fill in on the machine only.
# `.env` is git-ignored.

# --- Runtime ---------------------------------------------------------------
# Web process port; Nginx proxies 127.0.0.1:3000 to it (ARCHITECTURE.md §14.1).
PORT=3000

# Business timezone: all dates, "today" and reminder schedules use it
# (ARCHITECTURE.md §12.7; AGENTS.md AG-Q4).
PKT_TZ=Asia/Karachi

# --- Database (ARCHITECTURE.md §14.2, §14.5, §14.6) -----------------------
# Superuser password: used only by the postgres image on first init.
POSTGRES_PASSWORD=change-me-superuser
# Runtime role spm_app: DML only, no DELETE on financial tables.
APP_DB_PASSWORD=change-me-app
# DDL role spm_migrator: used only by `docker compose run --rm migrate`.
MIGRATOR_PASSWORD=change-me-migrator

# Runtime connection string. Compose builds it from APP_DB_PASSWORD, as in
# ARCHITECTURE.md §14.2; set it explicitly when running the app on a host.
DATABASE_URL=postgresql://spm_app:change-me-app@localhost:5432/spm

# --- Secrets (ARCHITECTURE.md §10.10, §14.5) ------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`). AES-256-GCM key for
# provider_config.secret_ciphertext. Rotation is not supported in the MVP;
# back this key up in the team password manager.
APP_SECRETS_KEY=change-me-32-byte-base64-key

# Bearer token for the operator-only health details route
# (API.md COR-4; ARCHITECTURE.md §14.1).
HEALTH_DETAILS_TOKEN=change-me-operator-token

# --- File storage (ARCHITECTURE.md §7.2) ----------------------------------
# Phase 1 ships the local driver. The default root is the fixed path from
# ARCHITECTURE.md §7.2; override only for a development machine, because the
# service account must be able to write there (AGENTS.md AG-Q4: a new key needs
# an AG-Q entry — this one is flagged in the Phase 1 PR).
FILE_STORE=local
FILE_STORE_ROOT=/srv/spm/files

# --- Sessions (ARCHITECTURE.md §15.2) -------------------------------------
# 30-minute idle and 12-hour absolute expiry.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Reminders (ARCHITECTURE.md §10.9) ------------------------------------
# Default `dry_run` in every environment until the client explicitly flips it
# to `live`. Dry run makes no provider call and writes SKIPPED log rows.
REMINDER_MODE=dry_run

# Provider API keys, tokens and passwords are NOT environment keys by default:
# they live encrypted in provider_config (§10.10). Environment override is
# allowed for ops but the variable names are chosen when that override is
# implemented — AGENTS.md AG-Q4 requires an AG-Q entry for new keys.

# --- Backups (ARCHITECTURE.md §14.5, §14.7) -------------------------------
# Nightly pg_dump + restic push to an S3-compatible, versioned bucket.
BACKUP_S3_ENDPOINT=https://s3.example.pk
BACKUP_S3_BUCKET=spm-backups
BACKUP_S3_ACCESS_KEY_ID=change-me-access-key
BACKUP_S3_SECRET_ACCESS_KEY=change-me-secret-key
RESTIC_PASSWORD=change-me-restic-repository-password

# --- Deployment (ARCHITECTURE.md §14.2, §14.4) ----------------------------
# Image tag deployed by infra/docker-compose.yml; rollback = previous SHA.
TAG=dev

# --- One-off admin creation (AGENTS.md AG-Q9) -----------------------------
# Used by the `npm run create-admin` procedure once Phase 1 implements it.
ADMIN_EMAIL=admin@example.pk
